# Copier ce fichier en .env.local et renseigner les valeurs
# (Supabase → Project Settings → API). Sur Vercel, ces mêmes variables
# sont déclarées dans Settings → Environment Variables.
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=
# E-mail du compte administrateur (créé dans Supabase → Authentication → Users).
# Le mot de passe n'est jamais stocké ici : il est demandé dans l'appli.
REACT_APP_ADMIN_EMAIL=
